+#pragma once
+
+#include "HybridMMKVPlatformContextSpec.hpp"
+
+namespace margelo::nitro::mmkv {
+
+class HybridMMKVPlatformContext final : public HybridMMKVPlatformContextSpec {
+public:
+  HybridMMKVPlatformContext() : HybridObject(TAG) {}
+
+  std::string getBaseDirectory() override;
+  std::optional<std::string> getAppGroupDirectory() override;
+};
+
+} // namespace margelo::nitro::mmkv
diff --git a/ios/HybridMMKVPlatformContext.mm b/ios/HybridMMKVPlatformContext.mm
new file mode 100644
index 0000000000000000000000000000000000000000..3a36bdc5838c3dba8c5686d679a9868e85899892
--- /dev/null
+++ b/ios/HybridMMKVPlatformContext.mm
@@ -0,0 +1,40 @@
+#import "HybridMMKVPlatformContext.hpp"
+
+#import <Foundation/Foundation.h>
+#import <TargetConditionals.h>
+
+namespace margelo::nitro::mmkv {
+
+std::string HybridMMKVPlatformContext::getBaseDirectory() {
+#if TARGET_OS_TV
+  constexpr auto directory = NSCachesDirectory;
+#else
+  constexpr auto directory = NSDocumentDirectory;
+#endif
+
+  NSArray<NSURL*>* paths = [[NSFileManager defaultManager] URLsForDirectory:directory inDomains:NSUserDomainMask];
+  NSURL* directoryURL = paths.firstObject;
+  if (directoryURL == nil) {
+    throw std::runtime_error("Cannot find base-path to store MMKV files!");
+  }
+
+  NSURL* mmkvURL = [directoryURL URLByAppendingPathComponent:@"mmkv" isDirectory:YES];
+  return mmkvURL.path.UTF8String;
+}
+
+std::optional<std::string> HybridMMKVPlatformContext::getAppGroupDirectory() {
+  NSString* appGroupID = [[NSBundle mainBundle] objectForInfoDictionaryKey:@"AppGroupIdentifier"];
+  if (appGroupID == nil) {
+    return std::nullopt;
+  }
+
+  NSURL* containerURL = [[NSFileManager defaultManager] containerURLForSecurityApplicationGroupIdentifier:appGroupID];
+  if (containerURL == nil) {
+    std::string message = "Container for AppGroup \"" + std::string(appGroupID.UTF8String) + "\" not accessible";
+    throw std::runtime_error(message);
+  }
+
+  return std::string(containerURL.path.UTF8String);
+}
+
+} // namespace margelo::nitro::mmkv
