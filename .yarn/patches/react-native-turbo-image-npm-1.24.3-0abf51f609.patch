+private struct SVGPathParser {
+    private let tokens: [String]
+    private var index = 0
+    private var command: Character?
+    private var current = CGPoint.zero
+    private var start = CGPoint.zero
+    private var lastCubicControl: CGPoint?
+    private var lastQuadraticControl: CGPoint?
+    var path: CGPath?
+
+    init(_ source: String) {
+        self.tokens = Self.tokenize(source)
+        self.path = nil
+        var parser = self
+        self.path = parser.parse()
+    }
+
+    private init(tokens: [String]) {
+        self.tokens = tokens
+        self.path = nil
+    }
+
+    private mutating func parse() -> CGPath? {
+        let path = CGMutablePath()
+        while index < tokens.count {
+            if let next = tokens[index].first, next.isLetter {
+                command = next
+                index += 1
+                if next == "Z" || next == "z" {
+                    path.closeSubpath()
+                    current = start
+                    command = nil
+                    continue
+                }
+            }
+            guard let activeCommand = command else { return path }
+            let relative = activeCommand.isLowercase
+            switch activeCommand.uppercased() {
+            case "M":
+                guard let point = point(relative: relative) else { return path }
+                path.move(to: point)
+                current = point
+                start = point
+                command = relative ? "l" : "L"
+                resetControls()
+            case "L":
+                guard let point = point(relative: relative) else { return path }
+                path.addLine(to: point)
+                current = point
+                resetControls()
+            case "H":
+                guard let x = number() else { return path }
+                current = CGPoint(x: relative ? current.x + x : x, y: current.y)
+                path.addLine(to: current)
+                resetControls()
+            case "V":
+                guard let y = number() else { return path }
+                current = CGPoint(x: current.x, y: relative ? current.y + y : y)
+                path.addLine(to: current)
+                resetControls()
+            case "C":
+                guard let c1 = point(relative: relative), let c2 = point(relative: relative), let point = point(relative: relative) else { return path }
+                path.addCurve(to: point, control1: c1, control2: c2)
+                current = point
+                lastCubicControl = c2
+                lastQuadraticControl = nil
+            case "S":
+                guard let c2 = point(relative: relative), let point = point(relative: relative) else { return path }
+                let c1 = lastCubicControl.map { CGPoint(x: current.x * 2 - $0.x, y: current.y * 2 - $0.y) } ?? current
+                path.addCurve(to: point, control1: c1, control2: c2)
+                current = point
+                lastCubicControl = c2
+                lastQuadraticControl = nil
+            case "Q":
+                guard let control = point(relative: relative), let point = point(relative: relative) else { return path }
+                path.addQuadCurve(to: point, control: control)
+                current = point
+                lastQuadraticControl = control
+                lastCubicControl = nil
+            case "T":
+                guard let point = point(relative: relative) else { return path }
+                let control = lastQuadraticControl.map { CGPoint(x: current.x * 2 - $0.x, y: current.y * 2 - $0.y) } ?? current
+                path.addQuadCurve(to: point, control: control)
+                current = point
+                lastQuadraticControl = control
+                lastCubicControl = nil
+            case "A":
+                guard let rx = number(), let ry = number(), let rotation = number(), let large = number(), let sweep = number(), let point = point(relative: relative) else { return path }
+                addArc(to: path, rx: rx, ry: ry, rotation: rotation, large: large != 0, sweep: sweep != 0, end: point)
+                current = point
+                resetControls()
+            default:
+                return path
+            }
+        }
+        return path
+    }
+
+    private mutating func point(relative: Bool) -> CGPoint? {
+        guard let x = number(), let y = number() else { return nil }
+        return CGPoint(x: relative ? current.x + x : x, y: relative ? current.y + y : y)
+    }
+
+    private mutating func number() -> CGFloat? {
+        guard index < tokens.count, let value = Double(tokens[index]) else { return nil }
+        index += 1
+        return CGFloat(value)
+    }
+
+    private mutating func resetControls() {
+        lastCubicControl = nil
+        lastQuadraticControl = nil
+    }
+
+    private mutating func addArc(to path: CGMutablePath, rx: CGFloat, ry: CGFloat, rotation: CGFloat, large: Bool, sweep: Bool, end: CGPoint) {
+        guard current != end else { return }
+        var rx = abs(rx), ry = abs(ry)
+        guard rx > 0, ry > 0 else { path.addLine(to: end); return }
+        let angle = rotation * .pi / 180
+        let cosAngle = cos(angle), sinAngle = sin(angle)
+        let dx = (current.x - end.x) / 2, dy = (current.y - end.y) / 2
+        let x1 = cosAngle * dx + sinAngle * dy, y1 = -sinAngle * dx + cosAngle * dy
+        let lambda = x1 * x1 / (rx * rx) + y1 * y1 / (ry * ry)
+        if lambda > 1 { let factor = sqrt(lambda); rx *= factor; ry *= factor }
+        let numerator = max(0, (rx * rx * ry * ry - rx * rx * y1 * y1 - ry * ry * x1 * x1) / (rx * rx * y1 * y1 + ry * ry * x1 * x1))
+        let factor = (large == sweep ? -1 : 1) * sqrt(numerator)
+        let cx1 = factor * rx * y1 / ry, cy1 = factor * -ry * x1 / rx
+        let cx = cosAngle * cx1 - sinAngle * cy1 + (current.x + end.x) / 2
+        let cy = sinAngle * cx1 + cosAngle * cy1 + (current.y + end.y) / 2
+        let startAngle = atan2((y1 - cy1) / ry, (x1 - cx1) / rx)
+        var delta = atan2((-y1 - cy1) / ry, (-x1 - cx1) / rx) - startAngle
+        if !sweep && delta > 0 { delta -= 2 * .pi }
+        if sweep && delta < 0 { delta += 2 * .pi }
+        let segments = max(1, Int(ceil(abs(delta) / (.pi / 2))))
+        let step = delta / CGFloat(segments)
+        for segment in 0..<segments {
+            let a0 = startAngle + CGFloat(segment) * step, a1 = a0 + step
+            let k = 4 / 3 * tan((a1 - a0) / 4)
+            let p0 = point(angle: a0, cx: cx, cy: cy, rx: rx, ry: ry, cosAngle: cosAngle, sinAngle: sinAngle)
+            let p1 = point(angle: a1, cx: cx, cy: cy, rx: rx, ry: ry, cosAngle: cosAngle, sinAngle: sinAngle)
+            let c1 = CGPoint(x: p0.x - k * derivative(angle: a0, rx: rx, ry: ry, cosAngle: cosAngle, sinAngle: sinAngle).x, y: p0.y - k * derivative(angle: a0, rx: rx, ry: ry, cosAngle: cosAngle, sinAngle: sinAngle).y)
+            let c2 = CGPoint(x: p1.x + k * derivative(angle: a1, rx: rx, ry: ry, cosAngle: cosAngle, sinAngle: sinAngle).x, y: p1.y + k * derivative(angle: a1, rx: rx, ry: ry, cosAngle: cosAngle, sinAngle: sinAngle).y)
+            path.addCurve(to: p1, control1: c1, control2: c2)
+        }
+    }
+
+    private func point(angle: CGFloat, cx: CGFloat, cy: CGFloat, rx: CGFloat, ry: CGFloat, cosAngle: CGFloat, sinAngle: CGFloat) -> CGPoint {
+        CGPoint(x: cx + rx * cosAngle * cos(angle) - ry * sinAngle * sin(angle), y: cy + rx * sinAngle * cos(angle) + ry * cosAngle * sin(angle))
+    }
+
+    private func derivative(angle: CGFloat, rx: CGFloat, ry: CGFloat, cosAngle: CGFloat, sinAngle: CGFloat) -> CGPoint {
+        CGPoint(x: -rx * cosAngle * sin(angle) - ry * sinAngle * cos(angle), y: -rx * sinAngle * sin(angle) + ry * cosAngle * cos(angle))
+    }
+
+    private static func tokenize(_ source: String) -> [String] {
+        guard let regex = try? NSRegularExpression(pattern: #"[A-Za-z]|[-+]?(?:\d*\.\d+|\d+\.?\d*)(?:[eE][-+]?[-]?\d+)?"#) else { return [] }
+        let range = NSRange(source.startIndex..., in: source)
+        return regex.matches(in: source, range: range).compactMap { match in
+            guard let range = Range(match.range, in: source) else { return nil }
+            return String(source[range])
+        }
     }
 }
